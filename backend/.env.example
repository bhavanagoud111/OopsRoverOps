# Copy to backend/.env and fill in your own values.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openrouter/polaris-alpha
NASA_API_KEY=your-nasa-api-key
BACKEND_PORT=8000

# MySQL (defaults match docker-compose.yml)
DB_HOST=localhost
DB_PORT=3307
DB_USER=roverops_user
DB_PASSWORD=your-db-password
DB_NAME=roverops_db
